{
  "name": "pos",
  "version": "0.2.0",
  "description": "Store Point of Sale is a desktop application developed by Hosting Domain and available for free download at www.storepointofsale.com.",
  "author": "Hosting Domain",
  "private": true,
  "type": "module",
  "main": "start.js",
  "build": {
    "appId": "01",
    "directories": {
      "buildResources": "assets"
    },
    "mac": {
      "target": "mas",
      "type": "distribution",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "category": "public.app-category.business",
      "icon": "iconbuilder.icns"
    },
    "linux": {
      "category": "Office",
      "icon": "assets/default.jpg"
    },
    "files": [
      "**/*",
      "assets/**/*",
      "node_modules/**/*",
      "public/**/*"
    ]
  },
  "dependencies": {
    "async": "^2.6.0",
    "body-parser": "^1.18.2",
    "btoa": "^1.2.1",
    "dotenv": "^16.0.3",
    "electron-context-menu": "^0.15.1",
    "electron-store": "^5.1.0",
    "electron-winstaller": "^4.0.0",
    "express": "^4.16.2",
    "express-fileupload": "^1.1.6",
    "html2canvas": "^1.0.0-rc.5",
    "http": "0.0.0",
    "https": "^1.0.0",
    "is-port-reachable": "^2.0.1",
    "jquery": "^3.4.1",
    "jsbarcode": "^3.11.0",
    "jspdf": "^2.3.1",
    "macaddress": "^0.2.9",
    "moment": "^2.24.0",
    "multer": "^1.4.2",
    "nedb": "^1.8.0",
    "nodemon": "^1.14.12",
    "path": "^0.12.7",
    "print-js": "^1.0.63",
    "socket.io": "^2.4.0",
    "sql.js": "^1.8.0",
    "stripe": "^12.3.0",
    "sweetalert2": "^9.5.4",
    "xmlhttprequest": "^1.8.0"
  },
  "scripts": {
    "electron": "cross-env NODE_ENV=dev nodemon --exec \"\"electron .\"\"",
    "electron-build": "electron-builder",
    "dist:mac": "electron-builder --mac --universal",
    "dist:linux": "electron-builder --linux",
    "package-win": "electron-packager . POS --overwrite --asar=false --platform=win32 --arch=x64 --icon=assets/images/icon.ico --prune=true --out=release-builds --version-string.ProductName=\"POS\"",
    "build:web": "webpack --mode production",
    "serve:web": "webpack serve --mode development"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@electron/get": "^1.0.1",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^13.0.0",
    "cross-env": "^6.0.3",
    "css-loader": "^6.8.1",
    "electron": "^13.6.6",
    "electron-builder": "^22.14.13",
    "electron-is-dev": "^1.1.0",
    "html-webpack-plugin": "^5.5.3",
    "nodemon": "^1.19.3",
    "style-loader": "^3.3.3",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
